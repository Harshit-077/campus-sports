# Copy to .env (untracked) and adjust.
ENVIRONMENT=development

# Local mongod. For Atlas use the mongodb+srv://... connection string.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=campus_sports

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# IANA timezone of the campus (slots are interpreted in this zone, stored in UTC)
CAMPUS_TIMEZONE=Asia/Kolkata

# Booking rules (optional; these are the defaults)
BOOKING_WINDOW_DAYS=14
CANCELLATION_CUTOFF_MINUTES=60
MAX_ACTIVE_BOOKINGS=5

# REQUIRED, at least 32 characters. The app refuses to start without it. Generate one with:
#   python3.12 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
